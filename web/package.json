{
  "name": "bussola-web",
  "private": true,
  "version": "0.1.0",
  "description": "Front web da Bússola (ciclo 008): simulação da jornada com dados sintéticos.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run varrer",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && tsc -b --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/gerar-fixtures.ts",
    "varrer": "tsx scripts/varrer-bundle.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
