# Bússola: variáveis de ambiente (contratos v1 §7).
# Copie para .env (não versionado) e ajuste. NUNCA coloque segredos neste arquivo.
#
# Este arquivo é o CONTRATO: o conjunto de nomes aqui é conferido contra a
# tabela de contratos §7 por mcp_server/tests/contrato/test_politicas_repo.py.
# Variável nova entra por PR `contracts:`, junto com a linha em contratos §7.
#
# O que roda no Cloud Run é configurado por deploy/helm/bussola/values.yaml, e
# pode divergir deste arquivo de propósito. As divergências conhecidas estão
# anotadas abaixo como "deploy vivo:" (conferidas em 2026-09-27 contra o
# values.yaml). Mudar o deploy não se faz aqui, e exige confirmação humana.

# --- GCP (ambos) ---
GOOGLE_CLOUD_PROJECT=batalha-time-07-lkbv
GOOGLE_CLOUD_LOCATION=us-central1
# MCP: região dos jobs e do dataset do BigQuery, lida por
# bussola_mcp.config.local_gcp() (padrão us-central1). Até o refactor de
# configuração ela era INERTE no MCP: env.example e values.yaml já injetavam
# us-central1, mas dominio/repositorio_bq.py tinha o literal e nunca lia a
# variável. Passou a ser lida com o mesmo padrão; valor efetivo inalterado.
# Agente: nenhum código nosso a lê (agent/bussola_agent/config.py não tem
# acessor, de propósito) — quem consome é o SDK google-genai ao montar o
# endpoint do Gemini. deploy vivo: o serviço agent recebe "global", não
# us-central1 (efeito de BUSSOLA_LOCAL_MODELO, Q-15 do 000).

# --- Modelos (agent, rag) ---
# TRUE = Vertex AI (Plano A). FALSE = Gemini API com GOOGLE_API_KEY (Plano B).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Também não é lida por código nosso: quem consome é o google-genai dentro de
# genai.Client() (agente e embeddings do RAG). Não procure um acessor.
# deploy vivo: definida só no serviço agent (FALSE, Plano B). O serviço mcp NÃO
# a define — ver a nota de RAG_BACKEND.
# Só no Plano B. O valor vem do Secret Manager (gemini-api-key). NUNCA versionar.
GOOGLE_API_KEY=
# ID do Gemini Flash validado por deploy/smoke_modelos.py (ciclo 000).
BUSSOLA_MODEL=gemini-3.8-flash
# Local do Vertex para o Gemini do agente (GOOGLE_CLOUD_LOCATION do agente).
# O Flash validado no 000 só responde em global (Q-15 do 000).
BUSSOLA_LOCAL_MODELO=global
# Nenhum código de aplicação lê esta variável; ela é de tempo de deploy. Quem a
# consome: deploy/deploy.sh (exporta como GOOGLE_CLOUD_LOCATION do serviço
# agent), o Makefile em `make agent`, e deploy/smoke_modelos.py só a cita na
# mensagem de resultado. deploy vivo: values.yaml não tem BUSSOLA_LOCAL_MODELO;
# tem o efeito dela já aplicado (services.agent.env.GOOGLE_CLOUD_LOCATION=global).
# ID do modelo de embedding validado por deploy/smoke_modelos.py (ciclo 000).
EMBEDDING_MODEL=gemini-embedding-001
# Busca do RAG no índice do repositório (Q-17): lexico (sem GCP) | numpy (embeddings, Plano A).
RAG_BACKEND=lexico
# deploy vivo: lexico no serviço mcp, e só esse valor sobe hoje. Virar para
# numpy quebraria a revisão viva: o BuscadorNumpy embute a pergunta com o
# GeminiEmbedder, que chama genai.Client(), e o values.yaml do mcp não define
# GOOGLE_GENAI_USE_VERTEXAI nem injeta a chave (secretEnv vazio) — falta de
# credencial no primeiro uso. Trocar exige antes, no values.yaml do mcp:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE (Vertex) ou a gemini-api-key em secretEnv.

# --- Agente ---
MCP_URL=http://localhost:8080/mcp
# FALSE local; TRUE no Cloud Run (ID token com audience = URL base do bussola-mcp).
MCP_USE_OIDC=FALSE
# Vazio = fallback de guardrails por callbacks (ciclo 005).
MODEL_ARMOR_TEMPLATE=
# deploy vivo: NÃO está no env do serviço agent em values.yaml, então a revisão
# viva roda o guardrail só pelas regras determinísticas — mesmo efeito de vazio.
# Parece intencional (criar o template do Model Armor exige modelarmor.admin,
# ver specs/000-fundacao-contratos/pedidos-owner.md), mas não estava escrito em
# lugar nenhum. values-plan-a.yaml, esse sim, traz MODEL_ARMOR_TEMPLATE="".
ANCHOR_USER_ID=36a21505-d6d4-42d3-b319-d51a133c7269
REPLAY_START_ANOMES=202506

# --- BigQuery ---
BQ_DATASET_DADOS=bussola_dados
# Testes: bussola_app_dev.
BQ_DATASET_APP=bussola_app
# query | memoria (Plano B, sem bigquery.jobUser)
BQ_MODO_LEITURA=query
# deploy vivo: memoria no serviço mcp, e a divergência é intencional. A SA de
# runtime não tem roles/bigquery.jobUser, então nada de job de query: o
# RepositorioBigQuery lê por list_rows (Plano B). Voltar para query depende de
# uma mudança de IAM, que exige confirmação humana.

# --- Comuns ---
BUSSOLA_FAKES=TRUE
LOG_LEVEL=INFO
PORT=8080
