# Bússola: variáveis de ambiente (contratos v1 §7).
# Copie para .env (não versionado) e ajuste. NUNCA coloque segredos neste arquivo.

# --- GCP (ambos) ---
GOOGLE_CLOUD_PROJECT=batalha-time-07-lkbv
GOOGLE_CLOUD_LOCATION=us-central1

# --- Modelos (agent, rag) ---
# TRUE = Vertex AI (Plano A). FALSE = Gemini API com GOOGLE_API_KEY (Plano B).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Só no Plano B. O valor vem do Secret Manager (gemini-api-key). NUNCA versionar.
GOOGLE_API_KEY=
# ID do Gemini Flash validado por deploy/smoke_modelos.py (ciclo 000).
BUSSOLA_MODEL=gemini-3.5-flash
# ID do modelo de embedding validado por deploy/smoke_modelos.py (ciclo 000).
EMBEDDING_MODEL=gemini-embedding-001

# --- Agente ---
MCP_URL=http://localhost:8080/mcp
# FALSE local; TRUE no Cloud Run (ID token com audience = URL base do bussola-mcp).
MCP_USE_OIDC=FALSE
# Vazio = fallback de guardrails por callbacks (ciclo 005).
MODEL_ARMOR_TEMPLATE=
ANCHOR_USER_ID=36a21505-d6d4-42d3-b319-d51a133c7269
REPLAY_START_ANOMES=202506

# --- BigQuery ---
BQ_DATASET_DADOS=bussola_dados
BQ_DATASET_RAG=bussola_rag
# Testes: bussola_app_dev.
BQ_DATASET_APP=bussola_app
# query | memoria (Plano B, sem bigquery.jobUser)
BQ_MODO_LEITURA=query
# bq | numpy (Plano B)
RAG_BACKEND=bq

# --- Comuns ---
BUSSOLA_FAKES=TRUE
LOG_LEVEL=INFO
PORT=8080
